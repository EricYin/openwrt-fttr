#!/bin/sh
# Child management connects to the parent's LAN IPv4 MQTT listener.
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "h3c,hm2004-du" ] || exit 0
[ "$(uci -q get mosquitto.owrt.use_uci)" = "0" ] || exit 0
lan_ip="$(uci -q get network.lan.ipaddr)"
[ -n "$lan_ip" ] || exit 1
uci set mosquitto.owrt.use_uci=1
uci set mosquitto.mosquitto.allow_anonymous=1
uci set mosquitto.mosquitto.log_dest=syslog
uci set mosquitto.fttr_loopback=listener
uci set mosquitto.fttr_loopback.port=1883
uci set mosquitto.fttr_loopback.bind_address=127.0.0.1
uci set mosquitto.fttr_lan=listener
uci set mosquitto.fttr_lan.port=1883
uci set "mosquitto.fttr_lan.bind_address=$lan_ip"
uci commit mosquitto
exit 0
