#!/bin/sh /etc/rc.common
START=80
STOP=20

USE_PROCD=1
PROG=/usr/sbin/fttrd
LAN_STATE=/var/run/fttr-mqtt-lan

start_service() {
	local acs_state acs_username acs_password lan_addr board dev i
	config_load fttr
	config_get acs_state acs state_file /var/lib/fttr/acs-state.json
	config_get acs_username acs username ""
	config_get acs_password acs password ""
	lan_addr=$(uci -q get network.lan.ipaddr)
	lan_addr=${lan_addr%%/*}

	# Only start on H3C HM2004-DU
	board=$(cat /tmp/sysinfo/board_name 2>/dev/null)
	if [ "$board" != "h3c,hm2004-du" ]; then
		return 0
	fi

	echo "[*] Initializing H3C FTTR Micro-OLT Subsystem..."
	# 1. Program FPGA Bitstream if needed (fallback if not auto-loaded by driver)
	if [ -f /lib/firmware/FTTR_TOP.sbit ] && [ ! -e /sys/devices/platform/fmcs/reload_fpga ]; then
		/usr/sbin/fttrctl load-fpga /lib/firmware/FTTR_TOP.sbit 2>/dev/null || true
	fi

	# 2. Setup downstream DSA switch ports (fttr1 ~ fttr16)
	for i in $(seq 1 16); do
		dev="fttr${i}"
		if [ -d "/sys/class/net/${dev}" ]; then
			ip link set "$dev" up 2>/dev/null
			ip link set "$dev" master br-lan 2>/dev/null || brctl addif br-lan "$dev" 2>/dev/null
		fi
	done

	# 3. Start Controller Daemon
	procd_open_instance
	procd_set_param command "$PROG"
	# ACS listener activation is coordinated by fttrd after management authorization.
	procd_set_param env FTTR_ACS_STATE="$acs_state" FTTR_ACS_USERNAME="$acs_username" FTTR_ACS_PASSWORD="$acs_password" FTTR_MQTT_LAN_ADDR="$lan_addr"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	# Record the listener value handed to this process, including an empty value.
	# MQTT-enabled fttrd validates it and fails before reporting broker readiness.
	printf '%s\n' "$lan_addr" > "$LAN_STATE"
}

stop_service() {
	echo "[*] Stopping H3C FTTR Subsystem..."
	rm -f "$LAN_STATE"
}

service_triggers() {
	procd_add_reload_trigger fttr network
}

reload_service() {
	local lan_addr applied_lan
	lan_addr=$(uci -q get network.lan.ipaddr)
	lan_addr=${lan_addr%%/*}
	# A stopped service has no applied listeners. Do not start it via reload.
	[ -f "$LAN_STATE" ] || return 0
	IFS= read -r applied_lan < "$LAN_STATE"
	if [ "$lan_addr" != "$applied_lan" ]; then
		# rc.common restart supplies the normal stop/start context; it is not a
		# recursive reload. start_service records the new value exactly once.
		restart
	else
		/usr/sbin/fttrctl config reload
	fi
}
