# Management defaults to read-only planning. Apply it from LuCI Synchronization.
# Each device must explicitly set option omci_management '1' to allow OMCI ACS/VLAN writes.
# Per-device option cwmp_contract 'auto' selects CWMP through read-only discovery,
# independently of the optical adapter. Explicit profiles: hl202-cu, hwtc-hw.
# Optional settings inside each existing config device section (enabled by default):
# option connection_request '1'
# option connection_request_defaults '1'
# option connection_request_username ''
# option connection_request_password ''
# option connection_request_port '7547'
# These are existing CPE Connection Request credentials, NOT the ACS login below.
# Factory profiles are unverified/unavailable. Set defaults '0' with verified custom credentials.
# No CPE credentials are changed. See ACS.md for wakeup status and restrictions.
config acs 'acs'
	option enabled '1'
	option port '7547'
	option path '/cwmp'
	option state_file '/var/lib/fttr/acs-state.json'
	option username ''
	option password ''
config provisioning 'provisioning'
	option enabled '1'
	option allow_unsupported_as_bridge '0'
	option mode 'manual'
	option freshness '180'
	option interval_minutes '30'
	list trigger 'config_change'
	list trigger 'device_online'
	list trigger 'cwmp_boot'
	# Optional: automatically sync eligible devices after fttrd starts.
	# list trigger 'program_start'

config management 'management'
	option enabled '1'
	option mode 'manual'
	list vlan '46'
	option priority '0'
	option address '192.168.46.1/24'
	option dhcp_enabled '1'
	option dhcp_start '100'
	option dhcp_limit '100'
	option dhcp_leasetime '12h'

config template 'home'
	option name 'Home'

config group 'home_group'
	option name 'Home'
	option template 'home'

config wifi 'wifi_2g'
	option template 'home'
	option ssid 'FTTR_2G'
	option radio '2g'

config wifi 'wifi_5g'
	option template 'home'
	option ssid 'FTTR_5G'
	option radio '5g'
