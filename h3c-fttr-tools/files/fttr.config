# Embedded ACS is opt-in; changing these options requires fttr restart/reload.
config acs 'acs'
	option enabled '0'
	option port '7547'
	option path '/cwmp'
	# Empty listen uses network.lan.ipaddr (never wildcard by default).
	option listen ''
	option state_file '/var/lib/fttr/acs-state.json'
	option username ''
	option password ''
	# Explicitly opt in to standard OMCI ACS association on K155 (unconfigured ME 340 only).
	option provision_k155 '0'
	# Management TCI: 0 means untagged; 1..4094 means VLAN with priority 0.
	option k155_vlan '0'
