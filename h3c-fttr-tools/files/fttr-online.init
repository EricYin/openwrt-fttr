#!/bin/sh /etc/rc.common
START=81
STOP=19
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "h3c,hm2004-du" ] || return 0
	# Validated HL202 ONU 1. Retry configuration while ranging recovers.
	procd_open_instance onu1
	procd_set_param command /usr/libexec/fttr-online 1
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}
