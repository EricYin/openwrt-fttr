#!/bin/sh /etc/rc.common
START=80
STOP=20

USE_PROCD=1
PROG=/usr/sbin/fttrd
LAN_STATE=/var/run/fttr-mqtt-lan

start_service() {
	local acs_state acs_username acs_password lan_addr
	chmod 600 /etc/config/fttr || return 1
	config_load fttr
	config_get acs_state acs state_file /var/lib/fttr/acs-state.json
	config_get acs_username acs username ""
	config_get acs_password acs password ""
	lan_addr=$(uci -q get network.lan.ipaddr)
	lan_addr=${lan_addr%%/*}

	# Let fttrd's exact platform registry fail closed before touching hardware.
	if ! "$PROG" --platform-check >/dev/null 2>&1; then
		return 0
	fi

	echo "[*] Initializing FTTR Micro-OLT Subsystem..."

	# Start the controller daemon.
	procd_open_instance
	procd_set_param command "$PROG"
	# ACS listener activation is coordinated by fttrd after management authorization.
	procd_set_param env FTTR_ACS_STATE="$acs_state" FTTR_ACS_USERNAME="$acs_username" FTTR_ACS_PASSWORD="$acs_password" FTTR_MQTT_LAN_ADDR="$lan_addr"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
	# Record the listener value handed to this process, including an empty value.
	# MQTT-enabled fttrd validates it and fails before reporting broker readiness.
	printf '%s\n' "$lan_addr" > "$LAN_STATE"
}

stop_service() {
	echo "[*] Stopping FTTR Subsystem..."
	if "$PROG" --platform-check >/dev/null 2>&1; then
		/usr/sbin/fttrctl optical shutdown --json || logger -t fttr "Owner shutdown failed; checking reset after termination"
	fi
	rm -f "$LAN_STATE"
}

service_stopped() {
	# procd deletion is asynchronous. The CLI waits boundedly for ownership;
	# it never writes hardware while a daemon still owns it.
	if "$PROG" --platform-check >/dev/null 2>&1; then
		/usr/sbin/fttrctl optical shutdown-offline --json || logger -t fttr "Optical reset not confirmed after stop"
	fi
}

service_triggers() {
	procd_add_reload_trigger fttr network
	# Run restart outside fttrd's cgroup so stopping fttrd cannot kill it.
	procd_add_raw_trigger "fttr.restart" 1000 /etc/init.d/fttr restart
}

reload_service() {
	local lan_addr applied_lan
	chmod 600 /etc/config/fttr || return 1
	lan_addr=$(uci -q get network.lan.ipaddr)
	lan_addr=${lan_addr%%/*}
	# A stopped service has no applied listeners. Do not start it via reload.
	[ -f "$LAN_STATE" ] || return 0
	IFS= read -r applied_lan < "$LAN_STATE"
	if [ "$lan_addr" != "$applied_lan" ]; then
		# rc.common restart supplies the normal stop/start context; it is not a
		# recursive reload. start_service records the new value exactly once.
		restart
	else
		/usr/sbin/fttrctl optical reload --json || return $?
		/usr/sbin/fttrctl config reload
	fi
}
